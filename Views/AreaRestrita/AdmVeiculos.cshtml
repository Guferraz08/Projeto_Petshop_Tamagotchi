@model List<Projeto_do_semestre.Models.Produto>

@{
    ViewData["Title"] = "Cadastro de Produtos";
    Layout = "~/Views/Shared/_Layout_Restrito.cshtml";
}

<div class="container mt-5 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white p-4"
             style="background-color: #14532d;">

            <h3 class="mb-1">
                Cadastro de Produtos
            </h3>

            <p class="mb-0">
                Área administrativa - Tamagotchi Pet Shop
            </p>

        </div>

        <div class="card-body p-4">

            @* MENSAGEM DO SISTEMA *@

            @if (TempData["mensagem"] != null)
            {
                <div class="alert alert-info">
                    @TempData["mensagem"]
                </div>
            }

            @* FORMULÁRIO DE CADASTRO *@

            <form asp-controller="AreaRestrita"
                  asp-action="SalvarProduto"
                  method="post"
                  enctype="multipart/form-data">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Nome do produto
                        </label>

                        <input type="text"
                               name="Nome"
                               class="form-control"
                               placeholder="Nome do produto"
                               required />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Categoria
                        </label>

                        <select name="Categoria"
                                class="form-select"
                                required>

                            <option value="">Selecione</option>
                            <option value="Ração">Ração</option>
                            <option value="Brinquedos">Brinquedos</option>
                            <option value="Acessórios">Acessórios</option>
                            <option value="Higiene">Higiene</option>
                            <option value="Medicamentos">Medicamentos</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Preço (R$)
                        </label>

                        <input type="number"
                               name="Preco"
                               class="form-control"
                               step="0.01"
                               min="0"
                               placeholder="89.90"
                               required />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Quantidade em estoque
                        </label>

                        <input type="number"
                               name="Quantidade"
                               class="form-control"
                               min="0"
                               placeholder="20"
                               required />

                    </div>

                    <div class="col-12 mb-3">

                        <label class="form-label">
                            Descrição
                        </label>

                        <textarea name="Descricao"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Descrição do produto"
                                  required></textarea>

                    </div>

                    @* CAMPO PARA SELECIONAR A FOTO *@

                    <div class="col-12 mb-3">

                        <label class="form-label">
                            Foto do produto
                        </label>

                        <input type="file"
                               name="arquivoImagem"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               onchange="visualizarImagem(event)" />

                        <small class="text-muted">
                            Formatos permitidos: JPG, JPEG, PNG e WEBP.
                            Tamanho máximo: 5 MB.
                        </small>

                    </div>

                    @* PRÉ-VISUALIZAÇÃO DA FOTO *@

                    <div class="col-12 mb-3">

                        <img id="previewImagem"
                             alt="Prévia do produto"
                             class="rounded border"
                             style="display: none;
                        width: 180px;
                        height: 180px;
                        object-fit: contain;" />

                    </div>

                </div>

                <hr />

                <button type="submit" class="btn btn-success">
                    Cadastrar produto
                </button>

                <button type="reset"
                        class="btn btn-secondary"
                        onclick="limparImagem()">
                    Limpar campos
                </button>

                <a asp-controller="AreaRestrita"
                   asp-action="Index"
                   class="btn btn-outline-dark">

                    Voltar

                </a>

            </form>

        </div>

    </div>

</div>

@* TABELA DE PRODUTOS CADASTRADOS *@

<div class="container mt-4 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white p-4"
             style="background-color: #14532d;">

            <h3 class="mb-1">Produtos cadastrados</h3>

            <p class="mb-0">
                Gerenciamento de produtos e estoque
            </p>

        </div>

        <div class="card-body p-4">

            <p>
                Total de produtos cadastrados:
                <strong>@Model.Count</strong>
            </p>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-success">

                        <tr>
                            <th>ID</th>
                            <th>Foto</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th>Estoque</th>
                            <th>Preço</th>
                            <th>Ações</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var produto in Model)
                        {
                            <tr>

                                <td>@produto.Id</td>

                                @* FOTO DO PRODUTO *@

                                <td>

                                    @if (!string.IsNullOrEmpty(produto.Imagem))
                                    {
                                        <img src="@produto.Imagem"
                                             alt="@produto.Nome"
                                             class="rounded border"
                                             style="width: 80px;
                                        height: 80px;
                                        object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded border
                                            d-flex align-items-center
                                            justify-content-center"
                                             style="width: 80px;
                                            height: 80px;">

                                            <i class="bi bi-image text-muted"
                                               style="font-size: 30px;">
                                            </i>

                                        </div>
                                    }

                                </td>

                                <td>@produto.Nome</td>

                                <td>@produto.Descricao</td>

                                <td>@produto.Categoria</td>

                                <td>@produto.Quantidade</td>

                                <td>
                                    @produto.Preco.ToString("C2",
                                    System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        @* BOTÃO EDITAR *@

                                        <a asp-controller="AreaRestrita"
                                           asp-action="EditarProduto"
                                           asp-route-id="@produto.Id"
                                           class="btn btn-warning btn-sm">

                                            <i class="bi bi-pencil-square"></i>
                                            Editar

                                        </a>

                                        @* BOTÃO EXCLUIR *@

                                        <form asp-controller="AreaRestrita"
                                              asp-action="ExcluirProduto"
                                              method="post"
                                              onsubmit="return confirm('Deseja realmente excluir este produto?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@produto.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">

                                                <i class="bi bi-trash"></i>
                                                Excluir

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning">
                    Nenhum produto cadastrado.
                </div>
            }

        </div>

    </div>

</div>

@* JAVASCRIPT PARA VISUALIZAR A FOTO *@

<script>

    function visualizarImagem(event) {

        const arquivo = event.target.files[0];
        const preview = document.getElementById("previewImagem");

        if (arquivo) {

            const leitor = new FileReader();

            leitor.onload = function (e) {

                preview.src = e.target.result;
                preview.style.display = "block";

            };

            leitor.readAsDataURL(arquivo);

        } else {

            limparImagem();

        }

    }

    function limparImagem() {

        const preview = document.getElementById("previewImagem");

        preview.removeAttribute("src");
        preview.style.display = "none";

    }

</script>