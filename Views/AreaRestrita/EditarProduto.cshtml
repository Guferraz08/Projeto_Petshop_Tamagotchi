@model Projeto_do_semestre.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
    Layout = "~/Views/Shared/_Layout_Restrito.cshtml";
}

<div class="container mt-5 mb-5">

    <div class="card shadow border-0">

        <div class="card-header text-white p-4"
             style="background-color: #14532d;">

            <h3 class="mb-1">Editar Produto</h3>

            <p class="mb-0">
                Área administrativa - Tamagotchi Pet Shop
            </p>

        </div>

        <div class="card-body p-4">

            <form asp-controller="AreaRestrita"
                  asp-action="AtualizarProduto"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All"
                     class="text-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Nome do produto
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Categoria
                        </label>

                        <select asp-for="Categoria"
                                class="form-select"
                                required>

                            <option value="">Selecione</option>
                            <option value="Ração">Ração</option>
                            <option value="Brinquedos">Brinquedos</option>
                            <option value="Acessórios">Acessórios</option>
                            <option value="Higiene">Higiene</option>
                            <option value="Medicamentos">Medicamentos</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Preço (R$)
                        </label>

                        <input asp-for="Preco"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Quantidade em estoque
                        </label>

                        <input asp-for="Quantidade"
                               type="number"
                               min="0"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-12 mb-3">

                        <label class="form-label">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="4"
                                  required></textarea>

                    </div>

                    @* FOTO ATUAL DO PRODUTO *@

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Foto atual
                        </label>

                        <div class="border rounded bg-light p-3 text-center">

                            @if (!string.IsNullOrEmpty(Model.Imagem))
                            {
                                <img src="@Model.Imagem"
                                     alt="@Model.Nome"
                                     class="rounded"
                                     style="width: 200px;
                                height: 200px;
                                object-fit: contain;" />
                            }
                            else
                            {
                                <div class="py-5">

                                    <i class="bi bi-image text-muted"
                                       style="font-size: 60px;">
                                    </i>

                                    <p class="text-muted mb-0">
                                        Produto sem foto
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                    @* SELECIONAR NOVA FOTO *@

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Alterar foto do produto
                        </label>

                        <input type="file"
                               name="arquivoImagem"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               onchange="visualizarImagem(event)" />

                        <small class="text-muted">
                            Formatos: JPG, JPEG, PNG e WEBP.
                            Máximo de 5 MB.
                        </small>

                        <div class="mt-3">

                            <img id="previewImagem"
                                 alt="Nova foto do produto"
                                 class="rounded border"
                                 style="display: none;
                            width: 200px;
                            height: 200px;
                            object-fit: contain;" />

                        </div>

                        <div class="alert alert-info mt-3">

                            <i class="bi bi-info-circle"></i>

                            Caso não selecione uma nova foto,
                            a imagem atual será mantida.

                        </div>

                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-check-circle"></i>
                    Salvar alterações

                </button>

                <a asp-controller="AreaRestrita"
                   asp-action="AdmVeiculos"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </form>

        </div>

    </div>

</div>

@* PRÉ-VISUALIZAÇÃO DA NOVA IMAGEM *@

<script>

    function visualizarImagem(event) {

        const arquivo = event.target.files[0];
        const preview = document.getElementById("previewImagem");

        if (arquivo) {

            const leitor = new FileReader();

            leitor.onload = function (e) {

                preview.src = e.target.result;
                preview.style.display = "block";

            };

            leitor.readAsDataURL(arquivo);

        } else {

            preview.removeAttribute("src");
            preview.style.display = "none";

        }

    }

</script>