@model List<Projeto_do_semestre.Models.Produto>

@{
    ViewData["Title"] = "Tamagotchi Pet Shop";
    Layout = "~/Views/Shared/_Layout_Publico.cshtml";
}

<section id="produtos" class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold" style="color: #14532d;">
            Nossos Produtos
        </h2>

        <p class="text-muted">
            Encontre tudo o que seu melhor amigo precisa!
        </p>

    </div>

    <div class="row g-4">

        @foreach (var produto in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card shadow-sm border-0 h-100 overflow-hidden">

                    @* IMAGEM DO PRODUTO *@

                    @if (!string.IsNullOrEmpty(produto.Imagem))
                    {
                        <img src="@produto.Imagem"
                             alt="@produto.Nome"
                             class="card-img-top p-3"
                             style="height: 250px;
                        width: 100%;
                        object-fit: contain;
                        background-color: #ffffff;"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center
                            justify-content-center"
                             style="height: 250px;
                            background-color: #e8f5e9;">

                            <i class="bi bi-box-seam"
                               style="font-size: 70px;
                                color: #14532d;">
                            </i>

                        </div>
                    }

                    @* INFORMAÇÕES DO PRODUTO *@

                    <div class="card-body p-4 d-flex flex-column">

                        <div>
                            <span class="badge bg-success mb-3">
                                @produto.Categoria
                            </span>
                        </div>

                        <h4 class="card-title fw-bold">
                            @produto.Nome
                        </h4>

                        <p class="card-text text-muted">
                            @produto.Descricao
                        </p>

                        <div class="mt-auto">

                            <h3 class="fw-bold text-success">

                                @produto.Preco.ToString("C2",
                                System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))

                            </h3>

                            @if (produto.Quantidade > 0)
                            {
                                <p class="text-success">

                                    <i class="bi bi-check-circle"></i>
                                    Disponível em estoque

                                </p>
                            }
                            else
                            {
                                <p class="text-danger">

                                    <i class="bi bi-x-circle"></i>
                                    Produto indisponível

                                </p>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning text-center">

            Nenhum produto disponível no momento.

        </div>
    }

</section>